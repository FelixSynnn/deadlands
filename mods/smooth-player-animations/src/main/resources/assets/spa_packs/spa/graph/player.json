    "vanilla": []
  },
  "procedural": {
    "_说明": "程序层：视角（头和脊柱分担：chest_share 是身体转的比例，spine_split 按骨盆、腰、胸分摊，让身体平顺地弯、不出折痕；骨盆的朝向跟着腿，分给骨盆的扭转会转到腰和胸上）、加减速前倾和转弯侧倾、灯笼摆动。落地没有程序下沉，用动作文件自己的（跳跃动作一直播到落地）。角度单位为度。",
    "look": {"chest_share": 0.25, "spine_split": [0, 0.4, 0.6], "max_yaw": 80, "max_pitch": 80},
    "lean": {"when": "q.on_ground && !q.crawling && !q.riding && !q.swimming",
             "forward": 1.6, "max_forward": 7, "bank": 0.5, "max_bank": 8, "halflife": 0.15},
    "lantern": {"when": "!q.bc_attacking && !q.external_body"},
    "flight": {"_说明": "创造模式飞行时身体和四肢跟着飞行方向动（参照 Fresh Animations 的玩家动画）：往前飞身体前倾、手脚往后拖；刹车时身体后仰、手往前甩；左右平移时身体侧倾、腿往反方向甩；转身时一只手往前一只手往后、双臂张开，腿往外甩。数值是角度：前后、左右按 reference（方块/秒）的速度算满，转身按 max_turn（度/秒）算满，刹车按半秒内停下算满；halflife 是平滑时间（秒）。",
               "when": "q.flying", "reference": 11, "max_turn": 300, "halflife": 0.2,
               "lean": 18, "brake": 14, "bank": 8, "turn_bank": 10,
               "arms_trail": 12, "arms_brake": 10, "arms_side": 4, "arms_turn_swing": 10, "arms_turn_out": 8,
               "legs_trail": 28, "legs_side": 20, "legs_turn": 18}
  }
